# Backend Environment Variables - EXAMPLE / TEMPLATE
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is gitignored.
# Production values must be set in the DigitalOcean App Platform dashboard.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
# Local: development | Production (DigitalOcean): production
NODE_ENV=development

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts → Generate new key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── PhonePe ──────────────────────────────────────────────────────────────────
# Get from https://developer.phonepe.com/ → Merchant Dashboard
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
# UAT = test mode | PROD = live payments
PHONEPE_ENV=UAT

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=orders@yourdomain.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local:       http://127.0.0.1:3000
# Production:  https://YOUR_APP.vercel.app  ← set this in DigitalOcean
FRONTEND_URL=http://127.0.0.1:3000

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to false in DigitalOcean for production
ALLOW_TEST_PAYMENTS=true
